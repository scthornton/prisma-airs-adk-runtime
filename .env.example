# Copy to .env and fill in. .env is gitignored.

# --- Prisma AIRS (required) ---
AIRS_API_KEY=                 # x-pan-token from Strata Cloud Manager
AIRS_API_PROFILE_NAME=        # your AIRS security profile name
# AIRS_API_BASE=https://service.api.aisecurity.paloaltonetworks.com  # default (US). Override for other regions.

# --- Model backend for the example agent (pick what your agent uses) ---
# The AIRS guard is model-agnostic. example_agent.py defaults to Gemini:
GOOGLE_API_KEY=               # only needed to run example_agent.py against Gemini
